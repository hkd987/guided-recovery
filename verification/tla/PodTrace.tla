------------------------------ MODULE PodTrace ------------------------------
(***************************************************************************)
(* Trace validation: does the real C++ flight core behave like the model?  *)
(*                                                                         *)
(* Traces.tla is generated by sim/apps/grtrace.cpp. It holds every change  *)
(* of the observable decision state the C++ FlightCore made in simulated   *)
(* flights and bench sessions, with the arming-switch input of that update. *)
(* Each change must be ONE step of PodLogic's Update for some choice of    *)
(* the sensor-evidence inputs the trace does not record.                   *)
(***************************************************************************)
EXTENDS PodLogic, Traces, Sequences, Naturals, FiniteSets, TLC

Proj(x) == [stage |-> x.stage, phase |-> x.phase, cand |-> x.cand, home |-> x.home,
            bench |-> x.bench, motors |-> x.motors, steer |-> x.steer, faults |-> x.faults]

Full(o) == [stage |-> o.stage, phase |-> o.phase, cand |-> o.cand, home |-> o.home,
            bench |-> o.bench, motors |-> o.motors, steer |-> o.steer, faults |-> o.faults,
            hazard |-> FALSE]

Allowed(o1, a, o2) ==
  \E in \in InputsFor(Full(o1)) : in.armed = a /\ Proj(Update(Full(o1), in)) = o2

Steps == UNION { { <<k, j>> : j \in 1..(Len(Traces[k]) - 1) } : k \in 1..Len(Traces) }

Bad == { st \in Steps :
           ~Allowed(Traces[st[1]][st[2]].o, Traces[st[1]][st[2] + 1].armed, Traces[st[1]][st[2] + 1].o) }

Report(b) == { <<TraceNames[st[1]], st[2], Traces[st[1]][st[2]].o, Traces[st[1]][st[2] + 1]>> : st \in b }

ASSUME \A k \in 1..Len(Traces) : Traces[k][1].o = Proj(InitState)
ASSUME PrintT(<<"traces", Len(Traces), "steps checked", Cardinality(Steps)>>)
ASSUME LET b == Bad IN PrintT(<<"disallowed steps", Cardinality(b), Report(b)>>) /\ b = {}

TInit == s = InitState
TNext == UNCHANGED s
=============================================================================
